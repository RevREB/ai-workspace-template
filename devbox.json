{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/main/.schema/devbox.schema.json",
  "packages": [
    "git@latest",
    "jq@latest",
    "nodejs@latest",
    "gh@latest",
    "bash@latest",
    "coreutils@latest",
    "gnused@latest",
    "gnugrep@latest",
    "findutils@latest",
    "gawk@latest"
  ],
  "env": {
    "WORKSPACE_ROOT": "$PWD",
    "AI_HOME": "$PWD/.aihome",
    "XDG_CACHE_HOME": "$PWD/.cache",
    "NPM_CONFIG_PREFIX": "$PWD/.aihome/npm",
    "PATH": "$PWD/bin:$PWD/.aihome/npm/bin:$PATH"
  },
  "shell": {
    "init_hook": [
      "mkdir -p .aihome/config .aihome/data .aihome/state .aihome/npm/bin .cache bin",
      "echo \"ai-workspace: $(basename \"$PWD\") ready — your shell is NOT sealed; AI CLIs are (bin/ shims) — 'devbox run doctor' to verify\""
    ],
    "scripts": {
      "provision": [
        "scripts/provision.sh \"$@\""
      ],
      "sync": [
        "scripts/sync.sh"
      ],
      "setup_opencode": [
        "curl -fsSL https://asbru.mininet/setup/opencode | sh"
      ],
      "ticket": [
        "scripts/ticket.sh \"$@\""
      ],
      "doctor": [
        "scripts/doctor.sh"
      ],
      "bridge": [
        "scripts/sealed-exec.sh scripts/bridge.sh \"$@\""
      ],
      "archive": [
        "scripts/archive.sh \"$@\""
      ],
      "clean": [
        "rm -rf .cache/ .devbox/"
      ],
      "reset-ai": [
        "rm -rf .aihome/ && echo 'AI home wiped — run: devbox run provision'"
      ]
    }
  }
}
