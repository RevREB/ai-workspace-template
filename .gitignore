# --- Devbox / Nix / direnv (rebuildable local state — never commit) ---
# devbox local state: the Nix profile symlinks + gcroots for this workspace
.devbox/
# direnv cache (devbox's direnv integration writes here on `direnv allow`)
.direnv/
# workspace XDG cache ($XDG_CACHE_HOME)
.cache/
# stray `nix build` output symlink, if ever created
result
result-*
# NOTE: devbox.lock is intentionally NOT ignored — it is the reproducibility
# lockfile (like package-lock.json). Commit it.

# --- Sealed AI home (provisioned per workspace, contains creds/tools) ---
.aihome/

# --- AI-CLI sealing shims (generated per roster by 'devbox run provision') ---
# bin/sealed is hand-written and roster-independent, so it IS committed.
bin/*
!bin/sealed

# --- No .env layer (tripwire) ---
# This template keeps all env in devbox.json. If someone reintroduces a .env,
# never commit it.
.env
.env.*

# --- OS noise ---
.DS_Store
