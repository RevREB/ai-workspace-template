#!/bin/bash

# Reload the devbox environment whenever devbox.json / devbox.lock change.
# direnv only watches .envrc by default, so edits to devbox.json (e.g. new env
# vars) would otherwise NOT take effect until a manual `direnv reload` — which
# is exactly the stale-env trap that let host config leak into a "sealed" shell.
watch_file devbox.json devbox.lock

# Automatically sets up your devbox environment whenever you cd into this
# directory via our direnv integration:

eval "$(devbox generate direnv --print-envrc)"

# check out https://www.jetify.com/docs/devbox/ide_configuration/direnv/
# for more details
